Algoritmo ArduinoHouse
	// Asignamos librería del #include
	LIBRERIA <- servoh
	Servo <- servoMotor
	// definimos variable al servoMotor
	Definir cuenta Como Entero
	cuenta <- 0
	// Entero nos referimos a digitales
	Definir pinMode13, pinMode12, pinMode2, pinMode4, pinMode7, pinMode8, servoMotor Como Entero
	// Real nos referimos a Analogicos
	Definir pinModeA1, pinModeA2, pinModeA3, begin Como Real
	// Serial Begin en 9600
	begin <- 9600
	cuenta <- 1
	Repetir
		Leer pinMode13
		// Si el pin digital del botón se presiona
		Si pinMode13=1 Y cuenta==1 Entonces
			cuenta <- 0
			// Espera para que no se lea doble vez
			Esperar 0.5 Segundos
		FinSi
		Leer pinMode13
		// Si el pin digital del botón se vuelve a presionar
		Si pinMode13=1 Y cuenta=0 Entonces
			cuenta <- 1
			Esperar 0.5 Segundos
		FinSi
		// Si el pin digital del botón se presiona
		Si cuenta=0 Entonces
			// El led del pin12 enciende
			pinMode12 <- 1
			Escribir 'pin12', pinMode12
			// Leds izquierda
			Leer pinModeA1
			Si pinModeA1<200 Entonces
				// El led del pin2 enciende
				pinMode2 <- 1
				Escribir 'pin2', pinMode2
			SiNo
				// El led del pin2 apaga
				pinMode2 <- 0
				Escribir 'pin2', pinMode2
			FinSi
			// leds centro
			Leer pinModeA2
			Si pinModeA2<200 Entonces
				pinMode4 <- 1
				Escribir 'pin4', pinMode4
				pinMode7 <- 1
				Escribir 'pin7', pinMode7
			SiNo
				pinMode4 <- 0
				Escribir 'pin4', pinMode4
				pinMode7 <- 0
				Escribir 'pin7', pinMode7
			FinSi
			// Leds derecha
			Leer pinModeA1
			Si pinModeA1<200 Entonces
				pinMode8 <- 1
				Escribir 'pin8', pinMode8
			SiNo
				pinMode8 <- 0
				Escribir 'pin8', pinMode8
			FinSi
			// El servo gira 0 grados
			servoMotor <- 0
			Escribir 'SERVOMOTOR', servoMotor
			Esperar 0.5 Segundos
			// El servo gira 180 grados
			servoMotor <- 180
			Escribir 'SERVOMOTOR', servoMotor
			Esperar 0.5 Segundos
		FinSi
		// Presion del boton por segunda vez
		Si cuenta==1 Entonces
			// SE apaga todo
			pinMode12 <- 0
			Escribir 'pin12', pinMode12
			pinMode8 <- 0
			Escribir 'pin8', pinMode8
			pinMode7 <- 0
			Escribir 'pin7', pinMode7
			pinMode4 <- 0
			Escribir 'pin4', pinMode4
			pinMode2 <- 0
			Escribir 'pin2', pinMode2
			servoMotor <- 0
			// El servo regresa a 0 grados
			Escribir 'SERVOMOTOR', servoMotor
		FinSi
	Hasta Que siempre
FinAlgoritmo
